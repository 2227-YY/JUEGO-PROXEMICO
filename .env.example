# Configuración de variables de entorno para Proxémica en Acción
# Copia este archivo a un nuevo archivo llamado .env e introduce tu API Key de Gemini:

# Tu clave de API de Google Gemini (obtenida en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Puerto en el que se ejecutará el servidor local (opcional, por defecto: 3000)
PORT=3000
